import Aesop
import Mathlib.Data.Nat.Basic

attribute [-instance] Fin.instOfNat
attribute [-instance] Lean.Grind.Semiring.ofNat

-- A Bitmask of size `n` is guaranteed to be strictly less than 2^n
abbrev Bitmask (n : Nat) : Type := Fin (1 <<< n)

namespace Bitmask

abbrev empty (n : Nat) : Bitmask n :=
  ⟨0, by
    have h1 : 1 <<< n = 2^n := by grind only [Nat.one_shiftLeft]
    have h2 : 1 ≤ 2^n := Nat.one_le_pow n 2 (by decide)
    omega⟩

abbrev var {n : Nat} (i : Fin n) : Bitmask n :=
  ⟨1 <<< i.val, by
    have hi := i.isLt
    have h1 : 1 <<< i.val = 2^i.val := by grind only [Nat.one_shiftLeft]
    have h2 : 1 <<< n = 2^n := by grind only [Nat.one_shiftLeft]
    have h3 : 2^i.val < 2^n := Nat.pow_lt_pow_right (by decide) hi
    omega⟩

abbrev unbind {n : Nat} (m : Bitmask (n + 1)) : Bitmask n :=
  ⟨m.val >>> 1, by
    have hm := m.isLt
    have h1 : 1 <<< (n + 1) = 2^(n + 1) := by grind only [Nat.one_shiftLeft]
    have h2 : 1 <<< n = 2^n := by grind only [Nat.one_shiftLeft]
    have h3 : m.val >>> 1 = m.val / 2 := by rfl
    have h4 : 2^(n + 1) = 2^n * 2 := Nat.pow_succ 2 n
    omega⟩

abbrev union {n : Nat} (m1 m2 : Bitmask n) : Bitmask n :=
  ⟨m1.val ||| m2.val, by
    have h2 : 1 <<< n = 2^n := Nat.one_shiftLeft n
    have hm1 : m1.val < 2^n := by rw [← h2]; exact m1.isLt
    have hm2 : m2.val < 2^n := by rw [← h2]; exact m2.isLt
    exact Nat.or_lt_two_pow hm1 hm2⟩

end Bitmask

-- `Term n s d`: `s` is now typed as `Bitmask n`, making invalid bitmasks impossible!
inductive Term : (n : Nat) → Bitmask n → Nat → Type
  | var : ∀ {n : Nat} (i : Fin n), Term n (Bitmask.var i) 0
  | abs : ∀ {n : Nat} {s : Bitmask (n + 1)} {d : Nat},
      Term (n + 1) s d → Term n (Bitmask.unbind s) (d + 1)
  | app : ∀ {n : Nat} {s1 s2 : Bitmask n} {d1 d2 : Nat},
      Term n s1 d1 → Term n s2 d2 → Term n (Bitmask.union s1 s2) (max d1 d2)

theorem max_var_bound {n : Nat} {s : Bitmask n} {d : Nat} (_ : Term n s d) : n ≤ n + d := by
  exact Nat.le_add_right n d

-- Cast a Term along propositional equalities of s and d using `decide`.
def castTerm {n : Nat} {s s' : Bitmask n} {d d' : Nat}
    (t : Term n s d) (hs : s = s' := by decide) (hd : d = d' := by decide) :
    Term n s' d' := by subst hs; subst hd; exact t

macro:max "⟦" t:term "⟧" : term => `(castTerm $t)

prefix:100 "ƛ " => Term.abs
infixl:70 " ⬝ " => Term.app
prefix:100 "# " => Term.var
macro:100 "##[" n:term "]" i:term:max : term => `(Term.var (n := $n) (Fin.mk $i (by decide)))

-- Helper function and macro for constructing bitmask literals: b{0, 1}
def toBitmaskList {n : Nat} (l : List Nat) : Bitmask n :=
  ⟨l.foldl (fun acc i => acc ||| (1 <<< i)) 0, by decide⟩

macro "b{" xs:term,* "}" : term => `(toBitmaskList [$xs,*])

namespace Term

-- 1. Identity Function: ƛx. x
def id : Term 0 ⟨0, by decide⟩ 1 := ƛ (# 0)

-- 2. Constant Function: ƛx. ƛy. x
def const : Term 0 ⟨0, by decide⟩ 2 := ⟦ƛ (ƛ (##[2] 1))⟧

-- 3. Church Numerals: ƛf. ƛx. f^n x
def zero : Term 0 ⟨0, by decide⟩ 2 := ƛ (ƛ (# 0))
def one  : Term 0 ⟨0, by decide⟩ 2 := ⟦ƛ (ƛ (##[2] 1 ⬝ # 0))⟧
def two  : Term 0 ⟨0, by decide⟩ 2 := ⟦ƛ (ƛ (##[2] 1 ⬝ (##[2] 1 ⬝ # 0)))⟧

-- 4. Church Successor: ƛn. ƛf. ƛx. f (n f x)
def succ : Term 0 ⟨0, by decide⟩ 3 :=
  ⟦ƛ (ƛ (ƛ (
    ##[3] 1 ⬝ ((##[3] 2 ⬝ ##[3] 1) ⬝ # 0)
  )))⟧

-- A term with 2 free variables, depth 0.
def freeTerm : Term 2 (b{0, 1}) 0 := ⟦##[2] 0 ⬝ ##[2] 1⟧

-- A term with 1 free variable, depth 1.
def boundAndFree : Term 1 (b{0}) 1 := ⟦ƛ (# 0 ⬝ ##[2] 1)⟧

end Term
